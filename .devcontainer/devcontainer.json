{
  "name": "IICT AI Defense Systems (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [8501, 8502],
  "portsAttributes": {
    "8501": {
      "label": "TruthGuard AI (Fake News Detector)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "8502": {
      "label": "PhishGuard AI (Phishing Email Detector)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt"
}
